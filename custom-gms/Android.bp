// Auto-generated Android.bp for proprietary APKs


genrule {
    name: "merge_Maps",
    srcs: [
        "proprietary/Maps/*.apk*",
    ],
    out: ["Maps.apk"],
    cmd: "cat $(in) > $(out)",
}

android_app_import {
